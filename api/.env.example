# The API's settings. Copy this file to api/.env and fill it in:
#   cp .env.example .env
# The server and the npm scripts read api/.env. A variable set in your shell
# overrides the file. docs/setup.md, or the comment above a setting, explains
# each one. Never commit .env.

# The port the API listens on. Defaults to 3000.
# PORT=3000

# The AWS region for DynamoDB and Cognito, such as us-east-1. Not needed with
# DynamoDB Local and cognito-local.
# AWS_REGION=

# DynamoDB: see "Create the DynamoDB table" in docs/setup.md.
# The table's name, such as sunday-school-dev. Left blank so a copied file
# can't point at another environment's table by default.
DYNAMODB_TABLE=
# Uncomment to use DynamoDB Local instead of AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito: see "Create the Cognito user pool" in docs/setup.md.
# The pool `npm run cognito:create` creates or finds, by name. Use the same
# name as DYNAMODB_TABLE, such as sunday-school-dev.
COGNITO_USER_POOL_NAME=
# `npm run cognito:create` prints these two.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Uncomment to use cognito-local instead of AWS.
# COGNITO_ENDPOINT=http://localhost:9229

# Email: the address the app's notification emails come from, such as
# no-reply@scheduler.example.org. It must be on the domain SES verified for the
# app (see "Create the server" in docs/setup.md), and the app shows it as
# "Sunday School Scheduler". Terraform sets it on the server. Leave it blank
# locally, and sending fails with an error that says so. To send real email
# from your machine, set it and sign in to AWS.
# EMAIL_FROM=

# Seed data: see "Load the seed data" in docs/setup.md.
# The password `npm run seed` gives both made-up accounts. At least 8 characters,
# with an uppercase letter, a lowercase letter, a number and a symbol. Keep it in
# quotes, such as SEED_PASSWORD="...": without them, a # starts a comment and
# the rest of the password is left out.
SEED_PASSWORD=
