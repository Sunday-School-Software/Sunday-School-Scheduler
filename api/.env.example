# The API's settings. Copy this file to api/.env and fill it in:
#   cp .env.example .env
# The server and the npm scripts read api/.env. A variable set in your shell
# overrides the file. docs/setup.md explains each setting. Never commit .env.

# The port the API listens on. Defaults to 3000.
# PORT=3000

# The AWS region for DynamoDB and Cognito, such as us-east-1. Not needed with
# DynamoDB Local and cognito-local.
# AWS_REGION=

# DynamoDB: see "Create the DynamoDB table" in docs/setup.md.
# The table's name, such as sunday-school-dev. Left blank so a copied file
# can't point at another environment's table by default.
DYNAMODB_TABLE=
# Uncomment to use DynamoDB Local instead of AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito: see "Create the Cognito user pool" in docs/setup.md.
# The pool `npm run cognito:create` creates or finds, by name. Use the same
# name as DYNAMODB_TABLE, such as sunday-school-dev.
COGNITO_USER_POOL_NAME=
# `npm run cognito:create` prints these two.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Uncomment to use cognito-local instead of AWS.
# COGNITO_ENDPOINT=http://localhost:9229
